{
  "name": "uriel",
  "version": "1.5.8",
  "main": "desktop/main.js",
  "bin": {
    "uriel": "./desktop/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.js.json",
    "smoke": "node tools/smoke.mjs",
    "fetch-ytdlp": "node tools/fetch-ytdlp.mjs",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "Esperant0s",
  "license": "MIT",
  "description": "Uriel - a lightweight music player.",
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@types/node": "^22.20.5",
    "buffer": "^6.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "peerjs": "1.5.5",
    "qrcode-generator": "2.0.4",
    "typescript": "^5.9.3",
    "youtubei.js": "^18.3.0"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Uriel",
  "desktopName": "uriel.desktop",
  "homepage": "https://github.com/Esperant0s/Uriel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esperant0s/Uriel.git"
  },
  "bugs": {
    "url": "https://github.com/Esperant0s/Uriel/issues"
  },
  "build": {
    "appId": "io.github.esperant0s.mural",
    "productName": "Uriel",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!desktop/bin/**",
      "!bundled-bin/**",
      "!mobile/**",
      "!tools/**",
      "!docs/**",
      "!capacitor.config.json",
      "!.claude/**",
      "!shared/vendor/**",
      "!shared/globals.d.ts",
      "!*.md",
      "!strip_comments.js",
      "!package-lock.json"
    ],
    "extraResources": [
      {
        "from": "bundled-bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "shared/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "shared/assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Esperant0s",
        "repo": "Uriel",
        "releaseType": "release"
      }
    ]
  }
}
