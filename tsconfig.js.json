{
  // shared/ and desktop/ are still JavaScript, typed with JSDoc. A file is type-checked once it carries
  // `// @ts-check` on its first line, and all of them do (build-info.js aside, CI writes that one). Strict like
  // the phone layer's tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["shared/*.js", "shared/app/*.js", "desktop/*.js", "shared/globals.d.ts"],
  "exclude": ["shared/vendor", "node_modules"]
}
