<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!-- the app is rebuilt on any change not listed here, which stops the music; a font size or
             language change while it plays in the background shouldn't do that -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|mcc|mnc|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- muriel://link?code=… from the QR code in Settings → Sync (opens the app and links it) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="muriel" android:host="link" />
                <!-- muriel://playlist?p=… from a shared playlist link (adds the playlist) -->
                <data android:scheme="muriel" android:host="playlist" />
            </intent-filter>

        </activity>

        <!-- The home-screen icon (Settings → Theme → App icon, AppIconPlugin): Android can only switch between icons
             the app ships with, so each style is a launcher entry of its own and one of them is on at a time.
             The PNGs come from tools/render-app-icons.js. -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_mural"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_mural"
            android:roundIcon="@mipmap/ic_mural_mural"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_default"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_default"
            android:roundIcon="@mipmap/ic_mural_default"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_editor"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_editor"
            android:roundIcon="@mipmap/ic_mural_editor"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_orbit"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_orbit"
            android:roundIcon="@mipmap/ic_mural_orbit"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_vinyl"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_vinyl"
            android:roundIcon="@mipmap/ic_mural_vinyl"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_cosmos"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_cosmos"
            android:roundIcon="@mipmap/ic_mural_cosmos"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_aurora"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_aurora"
            android:roundIcon="@mipmap/ic_mural_aurora"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_sunset"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_sunset"
            android:roundIcon="@mipmap/ic_mural_sunset"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_amethyst"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_amethyst"
            android:roundIcon="@mipmap/ic_mural_amethyst"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_y2k_disc"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_y2k_disc"
            android:roundIcon="@mipmap/ic_mural_y2k_disc"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_cassette"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_cassette"
            android:roundIcon="@mipmap/ic_mural_cassette"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon_invincible"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_mural_invincible"
            android:roundIcon="@mipmap/ic_mural_invincible"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- keeps the music going in the background and carries the playback notification (MediaControlsPlugin) -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+: the song as a "Live Update", in the island at the top of the screen or the status bar
         (MediaControlsPlugin.postIsland). Granted at install, not asked for; older versions ignore it. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- awake (CPU + Wi-Fi) while the next song downloads with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the "Play in the background" switch: asks to be left out of battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- in-app updates: the downloaded Uriel.apk goes to Android's installer (AppUpdaterPlugin) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 10 and older: downloaded songs are saved to Music/Mural on the phone's storage (mobile/shims/store.js;
         asked for on the first download). Android 11+ needs no permission for the files the app saves there.
         requestLegacyExternalStorage above makes such paths writable on Android 10; newer versions ignore it. -->
    <!-- the songs already on the phone, listed in My files (DeviceMusicPlugin): "Music and audio" on Android 13+,
         storage access before that (Android 10 and older also use it for downloads, above) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
